# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=mlops_secret_change_me

# ── SMTP (Grafana gửi email alert) ────────────────────────────────────────────
# Gmail example: bật "App Password" trong Google Account, dùng app password ở đây
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=your-team-email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your-team-email@gmail.com

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5100
MODEL_NAME=Churn_Predict
MODEL_ALIAS=champion
MODEL_VERSION=1.0.0

# ── BentoML Image ────────────────────────────────────────────────────────────
IMAGE_TAG=churn-prediction:latest
